<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé ni transféré : base du référentiel et mots de passe
     chiffrés restent sur l'appareil (ADR-0010). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
