<?xml version="1.0" encoding="utf-8"?>
<!-- Compte système, adaptateur de synchronisation des contacts et écrans
     (ADR-0004, ADR-0009). Pas de sauvegarde Android : les mots de passe
     chiffrés ne quittent pas l'appareil (ADR-0010). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <application
        android:name=".UnicontactsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraction"
        android:icon="@drawable/icone"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".ui.ActivitePrincipale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exporté sans permission, comme tout authentificateur : seul le
             gestionnaire de comptes du système s'y lie, et il ne porte aucun
             secret (ADR-0010). -->
        <service
            android:name=".compte.ServiceAuthentificateur"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authentificateur" />
        </service>

        <service
            android:name=".synchro.ServiceSynchro"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/synchronisation" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>
    </application>
</manifest>
